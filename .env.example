# Copy to .env and fill in — or just run `npm run auth`, which writes this file for you.
# .env is git-ignored. Never commit real credentials.

# From your OAuth client at https://api-console.zoho.com (or your region's console).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Long-lived token minted by `npm run auth`. Treat it like a password:
# it grants ongoing access to the mailbox.
ZOHO_REFRESH_TOKEN=

# Region your Zoho account lives in: us | eu | in | au | jp | ca | sa | uk
# Must match where you signed up — tokens and IDs are not portable across regions.
ZOHO_DC=us

# Optional: pin to one mailbox. Omit to use the first account on the login.
# ZOHO_ACCOUNT_ID=

# Optional: when true, send/reply/move/mark tools are not registered at all.
# ZOHO_MAIL_READ_ONLY=false

# Optional: per-request timeout in milliseconds (default 30000).
# ZOHO_TIMEOUT_MS=30000

# --- HTTP transport only (npm run start:http) ---
# Required unless MCP_ALLOW_NO_AUTH=true. Use a long random string.
# MCP_BEARER_TOKEN=
# PORT=3000
# HOST=127.0.0.1
